  "components": [
    {
      "name": "Primary button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Crimson action pill with a single deliberate hover reflection.",
      "html": "<button class=\"ds-primary\">Run experiment <span>↗</span></button>",
      "css": ".ds-primary{position:relative;overflow:hidden;isolation:isolate;display:inline-flex;align-items:center;gap:25px;background:var(--accent-solid);border:1px solid var(--accent-solid);color:#fff;border-radius:24px;padding:13px 21px;font:550 12px/1.4 \"DM Sans\",Arial,sans-serif;cursor:pointer;transition:background 200ms,transform 200ms}.ds-primary:hover{background:var(--accent-hover);border-color:var(--accent-hover)}.ds-primary:active{transform:scale(.98)}.ds-primary:focus-visible{outline:3px solid var(--accent);outline-offset:4px;}.ds-primary:disabled{opacity:.5;cursor:not-allowed}.ds-primary span{font-size:20px;line-height:1;transition:transform 200ms cubic-bezier(.16,1,.3,1)}.ds-primary:hover span{transform:translate(2px,-2px)}.ds-primary:before{content:\"\";position:absolute;inset:0;z-index:-1;pointer-events:none;background:linear-gradient(105deg,transparent 25%,#ffffff28 50%,transparent 75%);transform:translateX(-140%)}@media(prefers-reduced-motion:no-preference){.ds-primary:hover:not(:disabled):before{transform:translateX(140%);transition:transform 650ms cubic-bezier(.16,1,.3,1)}}@media(prefers-reduced-motion:reduce){.ds-primary,.ds-primary:before,.ds-primary span,.ds-secondary,.ds-field,.ds-nav a,.ds-chapter,.ds-chapter h3{transition:none!important;animation:none!important}}"
    },
    {
      "name": "Secondary button",
      "kind": "button",
      "refersTo": "button-secondary-dark",
      "description": "Neutral outlined action, inheriting the active appearance.",
      "html": "<button class=\"ds-secondary\">Export data</button>",
      "css": ".ds-secondary{background:transparent;border:1px solid var(--line);border-radius:20px;padding:10px 14px;color:var(--text);font:11px/1.5 \"DM Sans\",Arial,sans-serif;cursor:pointer;transition:background 180ms ease,color 180ms ease,border-color 180ms ease}.ds-secondary:hover{background:var(--surface-hover)}.ds-secondary:focus-visible{outline:3px solid var(--accent);outline-offset:4px;}@media(prefers-reduced-motion:reduce){.ds-primary,.ds-primary:before,.ds-primary span,.ds-secondary,.ds-field,.ds-nav a,.ds-chapter,.ds-chapter h3{transition:none!important;animation:none!important}}"
    },
    {
      "name": "Scientific field",
      "kind": "input",
      "refersTo": "field-dark",
      "description": "Neutral scientific input with explicit label and visible focus.",
      "html": "<label class=\"ds-field-label\" for=\"ds-sample\">Sample size</label><input class=\"ds-field\" id=\"ds-sample\" type=\"number\" value=\"256\" min=\"1\">",
      "css": ".ds-field-label{display:block;color:var(--text);font:12px \"DM Sans\",Arial,sans-serif;margin-bottom:8px}.ds-field{display:block;width:100%;min-height:39px;padding:10px 11px;background:var(--surface);color:var(--text);border:1px solid var(--line);border-radius:8px;font:12px \"DM Sans\",Arial,sans-serif;caret-color:var(--accent)}.ds-field:focus-visible{outline:3px solid var(--accent);outline-offset:4px;}"
    },
    {
      "name": "Main navigation",
      "kind": "nav",
      "description": "Smoked sticky chapter navigation with a crimson current-route rule.",
      "html": "<nav class=\"ds-nav\" aria-label=\"Homework navigation\"><a href=\"#hw1\">Homework 1</a><a href=\"#hw2\" aria-current=\"page\">Homework 2</a><a href=\"#hw3\">Homework 3</a></nav>",
      "css": ".ds-nav{display:flex;gap:26px;height:86px;background:var(--glass);backdrop-filter:blur(16px);border-bottom:1px solid var(--line);overflow-x:auto;font:12px \"DM Sans\",Arial,sans-serif}.ds-nav a{position:relative;display:flex;align-items:center;flex-shrink:0;color:var(--muted);text-decoration:none}.ds-nav a:hover{color:var(--ink)}.ds-nav a[aria-current]{color:var(--accent);font-weight:600}.ds-nav a[aria-current]:after{content:\"\";position:absolute;bottom:0;left:0;right:0;height:2px;background:var(--accent)}.ds-nav a:focus-visible{outline:3px solid var(--accent);outline-offset:4px;}"
    },
    {
      "name": "Scientific panel",
      "kind": "card",
      "refersTo": "panel-dark",
      "description": "Quiet neutral enclosure for calculation and interpretation.",
      "html": "<article class=\"ds-panel\"><h3>Distribution of changed output bits</h3><p>Inspect measured counts against the stated model reference.</p></article>",
      "css": ".ds-panel{padding:23px;background:var(--surface);color:var(--ink);border:1px solid var(--line);border-radius:12px;font-family:\"DM Sans\",Arial,sans-serif}.ds-panel h3{font-size:15px;font-weight:550;line-height:1.4;margin:0 0 15px}.ds-panel p{font-size:14px;line-height:1.85;color:var(--text);margin:0;max-width:75ch}"
    },
    {
      "name": "Subject tag",
      "kind": "chip",
      "description": "Compact neutral content label, borderless inside the chapter index.",
      "html": "<span class=\"ds-tag\">STOCHASTIC PROCESSES</span>",
      "css": ".ds-tag{display:inline-block;white-space:nowrap;border:1px solid var(--line);border-radius:20px;padding:5px 9px;color:var(--ink);font:550 8px \"DM Sans\",Arial,sans-serif;letter-spacing:1.1px}"
    },
    {
      "name": "Ruled chapter entry",
      "kind": "custom",
      "description": "Full chapter link with open edges, serif title and a quiet accent hover.",
      "html": "<a class=\"ds-chapter\" href=\"#hw5\"><span>Homework 5</span><h3>From individual scores<br>to reliable estimates.</h3><p>Derive an online update and compare sampling statistics.</p></a>",
      "css": ".ds-chapter{display:block;border-top:1px solid var(--line);padding:28px 0 0;background:transparent;color:var(--ink);text-decoration:none;transition:border-color 180ms ease}.ds-chapter>span{color:var(--accent);font:600 13px \"DM Sans\",Arial,sans-serif}.ds-chapter h3{font:400 35px/1.12 \"Libre Caslon Display\",Georgia,serif;margin:22px 0 15px;transition:color 180ms ease}.ds-chapter p{color:var(--text);font:12px/1.85 \"DM Sans\",Arial,sans-serif;max-width:380px}.ds-chapter:hover{border-color:var(--accent)}.ds-chapter:hover h3{color:var(--accent)}.ds-chapter:focus-visible{outline:3px solid var(--accent);outline-offset:4px;}@media(prefers-reduced-motion:reduce){.ds-primary,.ds-primary:before,.ds-primary span,.ds-secondary,.ds-field,.ds-nav a,.ds-chapter,.ds-chapter h3{transition:none!important;animation:none!important}}"
    }
  ],
  "narrative": {
    "northStar": "The Academic Notebook",
    "overview": "A sober academic notebook: serif chapter openings, restrained sans-serif reading, neutral scientific panels and a flat ruled chapter index. The reference-guided finish uses crimson for actions and orientation while preserving the established academic identity and concept → experiment → measurement → interpretation sequence.\n\nCharcoal is the default; warm-paper light mode is an equally supported, saved alternative. Mathematical figures carry evidence rather than decoration. Interactions acknowledge a deliberate action, then settle.",
    "keyCharacteristics": [
      "Locally hosted serif display and DM Sans reading.",
      "Two coordinated appearances with semantic data colors.",
      "Ruled chapter navigation and neutral experiment surfaces.",
      "Brief state feedback with a static reduced-motion alternative."
    ],
    "rules": [
      {
        "name": "The Series Agreement Rule",
        "body": "A series and its legend use the same semantic token in both appearances; line style and labels distinguish measured data from model references.",
        "section": "colors"
      },
      {
        "name": "The Quiet Surface Rule",
        "body": "Use rules and neutral surface contrast for structure; keep the chapter index flat and reserve crimson emphasis for actions, orientation and meaningful data.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do support both saved appearances on every chapter.",
      "Do preserve English content, academic identity and the concept → experiment → measurement → interpretation sequence.",
      "Do use semantic series tokens for plots and matching legends.",
      "Do put section metadata below its heading and preserve readable scientific labels.",
      "Do keep visible keyboard focus, local chart/table scrolling and static reduced-motion feedback."
    ],
    "donts": [
      "Don't introduce a new font pairing or a separate identity for another homework.",
      "Don't turn scientific panels into saturated promotional cards.",
      "Don't use a decorative curve in place of computed mathematical data.",
      "Don't add unattended looping animation or make a theme change move the page layout."
    ]
  }
}
